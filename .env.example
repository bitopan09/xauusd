# Server Configuration
PORT=5002
NODE_ENV=production

# Email Configuration (Gmail example)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
NOTIFY_EMAIL=your-email@gmail.com

# Bot Configuration
BOT_ENABLED=true

# Trading Configuration
XAU_QUANTITY=0.01
RISK_PERCENTAGE=2
CONFLUENCE_THRESHOLD=6
MIN_DIRECTIONAL_MARGIN=1
TP1_RR=3
TP2_RR=5
TP1_CLOSE_PERCENT=50
MAX_LOSS_PERCENT=5
MAX_CANDLE_AGE_HOURS=8
NEWS_FILTER_ENABLED=true
USD_NFP_FILTER=true
# Optional format: 2026-06-12T12:00:00Z/2026-06-12T14:00:00Z,2026-07-10T12:00:00Z/2026-07-10T14:00:00Z
USD_NEWS_BLOCKS=

# Weighted confluence factors
WEIGHT_TREND=1.2
WEIGHT_RSI=0.8
WEIGHT_MACD=1
WEIGHT_CPR=0.8
WEIGHT_VWAP=0.8
WEIGHT_LIQUIDITY=1.4
WEIGHT_WYCKOFF_BONUS=0.8
WEIGHT_OTE=0.9
WEIGHT_OBFVG=1.2
WEIGHT_STRUCTURE=1.3
WEIGHT_VOLUME=0.7

# Telegram (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
SEND_TELEGRAM_ON_TRADE=true

# Deployment
RENDER_EXTERNAL_URL=https://your-app-domain.railway.app

# Timezone
TIMEZONE=Asia/Kolkata

# Logging
LOG_LEVEL=info
SEND_EMAIL_ON_TRADE=true
SEND_TELEGRAM_ON_TRADE=true
SEND_DAILY_SUMMARY=true
SEND_ERROR_ALERTS=true
